---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingStats, formatReadingTime } from '../utils/reading-time';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---
<section class="post-list-section">
	<ul class="post-list">
		{
			posts.map((post) => {
				const stats = readingStats(post.body ?? '');
				return (
					<li class="post-item">
						<a href={`${import.meta.env.BASE_URL}blog/${post.id}/`} class="post-link">
							<div class="body">
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
									<span class="dot" aria-hidden="true">·</span>
									<span>{formatReadingTime(stats)}</span>
								</p>
								<h3 class="title">{post.data.title}</h3>
								{post.data.categories && post.data.categories.length > 0 && (
									<p class="tags">
										{post.data.categories.map((cat) => (
											<span class="tag">{cat}</span>
										))}
									</p>
								)}
								{post.data.description && (
									<p class="summary">{post.data.description}</p>
								)}
							</div>
							{post.data.heroImage && (
								<div class="thumb">
									<Image width={360} height={180} src={post.data.heroImage} alt="" />
								</div>
							)}
						</a>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-item {
		display: block;
	}
	.post-link {
		display: grid;
		grid-template-columns: 1fr 220px;
		gap: var(--space-8);
		align-items: start;
		text-decoration: none;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		min-width: 0;
	}
	.date {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--color-text-muted);
		letter-spacing: 0.02em;
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}
	.date .dot {
		opacity: 0.5;
	}
	.title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: var(--leading-snug);
		letter-spacing: -0.01em;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: text-decoration-color 0.15s ease;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.post-link:hover .title {
		text-decoration-color: var(--color-accent);
	}
	.tags {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.tag {
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.summary {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-relaxed, 1.7);
		color: var(--color-text-soft);
	}
	.thumb {
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--color-bg-soft);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.post-link:hover .thumb :global(img) {
		transform: scale(1.03);
	}

	@media (max-width: 720px) {
		.post-link {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
		.title {
			white-space: normal;
		}
	}
</style>
