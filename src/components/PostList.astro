---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingStats } from '../utils/reading-time';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---
<section class="post-list-section">
	<ul class="post-list">
		{
			posts.map((post) => {
				const stats = readingStats(post.body ?? '');
				return (
					<li class="post-item">
						<a href={`${import.meta.env.BASE_URL}blog/${post.id}/`} class="post-link">
							<div class="body">
								<p class="meta">
									<FormattedDate date={post.data.pubDate} />
									<span class="meta-sep" aria-hidden="true">·</span>
									<span>{stats.minutes} min</span>
								</p>
								<h3 class="title">{post.data.title}</h3>
								{post.data.categories && post.data.categories.length > 0 && (
									<p class="tags">
										{post.data.categories.map((cat) => (
											<span class="tag">{cat}</span>
										))}
									</p>
								)}
								{post.data.description && (
									<p class="summary">{post.data.description}</p>
								)}
							</div>
							{post.data.heroImage && (
								<div class="thumb">
									<Image width={360} height={180} src={post.data.heroImage} alt="" />
								</div>
							)}
						</a>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-item {
		display: block;
	}
	.post-link {
		display: grid;
		grid-template-columns: 1fr 160px;
		gap: var(--space-8);
		align-items: start;
		text-decoration: none;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
	}
	.meta {
		margin: 0 0 var(--space-1);
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--color-text-muted);
		letter-spacing: 0.01em;
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}
	.meta-sep {
		opacity: 0.5;
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: -0.005em;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
		transition: text-decoration-color 0.15s ease;
	}
	.post-link:hover .title {
		text-decoration-color: var(--color-accent);
	}
	.tags {
		margin: var(--space-1) 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.tag {
		display: inline-block;
		padding: 3px 10px;
		background: var(--color-accent-soft);
		color: var(--color-accent-text);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.4;
	}
	.summary {
		margin: var(--space-1) 0 0;
		font-family: var(--font-prose);
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text);
	}
	.thumb {
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--color-bg-soft);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	.post-link:hover .thumb :global(img) {
		transform: scale(1.05);
	}

	@media (max-width: 720px) {
		.post-link {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
		.title {
			white-space: normal;
		}
	}
</style>