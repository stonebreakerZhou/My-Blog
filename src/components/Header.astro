---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Menu from './Menu.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<Menu />
		<div id="main-menu" class="nav-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/HelloMyWorld419" target="_blank">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://www.zhihu.com/people/laughable-young" target="_blank">
				<span class="sr-only">知乎</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M7.5 6.5C7.5 4.015 9.515 2 12 2s4.5 2.015 4.5 4.5c0 1.548-.8 2.891-1.995 3.605l-.145.06.03.315c.017.174-.083.347-.245.424l-.465.225-.36.18-.045.03C13.12 11.715 12.075 12 11 12s-2.12-.285-3.275-.761l-.045-.03-.36-.18-.465-.225c-.162-.077-.262-.25-.245-.424l.03-.315-.145-.06C8.3 9.391 7.5 8.048 7.5 6.5zM12 4c-1.93 0-3.5 1.57-3.5 3.5S10.07 11 12 11s3.5-1.57 3.5-3.5S13.93 4 12 4zm-5 8v7.5c0 2.485 3.54 4.5 7 4.5s7-2.015 7-4.5V12h-2v7.5c0 1.93-2.57 3.5-5 3.5s-5-1.57-5-3.5V12h-2z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.menu {
		background-color: #0d0950;
		border: none;
		color: #fff;
		font-size: 1.2rem;
		font-weight: bold;
		padding: 5px 10px;
		border-radius: 4px;
	}
	.nav-links {
		width: 100%;
		display: none;
		margin: 0;
	}
	.nav-links a {
		display: block;
		text-align: center;
		padding: 10px 0;
		text-decoration: none;
		font-size: 1.2rem;
		font-weight: bold;
		text-transform: uppercase;
		color: #0d0950;
	}
	.nav-links a:hover,
	.nav-links a:focus {
		background-color: #ff9776;
	}
	:global(:has(.menu[aria-expanded="true"])) .nav-links {
		display: unset;
	}
	@media screen and (min-width: 720px) {
		.nav-links {
			margin-left: 5em;
			display: block;
			position: static;
			width: auto;
			background: none;
		}
		.nav-links a {
			display: inline-block;
			padding: 15px 20px;
		}
		.menu {
			display: none;
		}
		.social-links {
			display: flex;
		}
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>