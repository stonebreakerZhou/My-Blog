---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Menu from './Menu.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header>
	<nav>
		<h2><a href={import.meta.env.BASE_URL}>{SITE_TITLE}</a></h2>
		<Menu />
		<div id="main-menu" class="nav-links">
			<HeaderLink href={import.meta.env.BASE_URL}>Home</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL}about/`}>About</HeaderLink>
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(10px);
		-webkit-backdrop-filter: saturate(180%) blur(10px);
		border-bottom: 1px solid var(--color-border-soft);
	}
	nav {
		display: flex;
		align-items: center;
		max-width: var(--container-max);
		margin: 0 auto;
		padding: var(--space-3) var(--space-4);
		gap: var(--space-6);
	}
	h2 {
		margin: 0;
		font-size: var(--text-md);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	h2 a {
		text-decoration: none;
		color: var(--color-text);
	}
	h2 a:hover {
		color: var(--color-accent);
	}

	.nav-links {
		display: none;
		flex-direction: column;
		gap: var(--space-3);
	}
	.nav-links a {
		display: block;
		padding: var(--space-2) var(--space-3);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-text-soft);
		transition: color 0.2s ease;
	}
	.nav-links a:hover {
		color: var(--color-accent);
	}

	:global(:has(.menu[aria-expanded="true"])) .nav-links {
		display: flex;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--color-bg-elev);
		border-bottom: 1px solid var(--color-border-soft);
		padding: var(--space-4);
	}

	@media screen and (min-width: 720px) {
		.menu {
			display: none;
		}
		.nav-links {
			display: flex;
			position: static;
			flex-direction: row;
			background: transparent;
			border: 0;
			padding: 0;
			margin-right: auto;
		}
		h2 {
			margin-right: var(--space-6);
		}
	}
</style>
