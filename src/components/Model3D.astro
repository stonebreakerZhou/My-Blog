			{ p: [0, 2.16, 0.04], s: [0.04, 0.04, 0.01], c: white },
			{ p: [0, 1.94, 0.04], s: [0.04, 0.04, 0.01], c: white },
			{ p: [0, 1.72, 0.04], s: [0.04, 0.04, 0.01], c: white },
