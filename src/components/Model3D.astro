			// Main block.
			{ p: [0, 2.95, 0], s: [0.32, 0.42, 0.05], c: cherry },
			// Tapered tip at the very top.
			{ p: [0, 3.18, 0], s: [0.22, 0.08, 0.05], c: cherry },

