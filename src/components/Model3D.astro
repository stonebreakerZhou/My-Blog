			{ p: [-0.2, 3.13, 0.02], s: [0.05, 0.05, 0.1], c: gold },
			{ p: [-0.2, 2.95, 0.02], s: [0.05, 0.05, 0.1], c: gold },
			{ p: [-0.2, 2.77, 0.02], s: [0.05, 0.05, 0.1], c: gold },
			{ p: [0.2, 3.13, 0.02], s: [0.05, 0.05, 0.1], c: gold },
			{ p: [0.2, 2.95, 0.02], s: [0.05, 0.05, 0.1], c: gold },
