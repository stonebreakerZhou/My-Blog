			{ p: [0.24, 3.13, 0.07], s: [0.035, 0.035, 0.03], c: gold },
			{ p: [0.24, 2.95, 0.07], s: [0.035, 0.035, 0.03], c: gold },
			{ p: [0.24, 2.77, 0.07], s: [0.035, 0.035, 0.03], c: gold },
		];

		guitar.add(mergeVoxels(bodyVoxels));
		setup.add(guitar);

		// === MINIMAL BASE STAND (just a small flat base + back lip) ===
		const stand: Voxel[] = [
			// Flat base plate (slightly wider than guitar body).
			{ p: [0, 0.04, 0], s: [0.5, 0.08, 0.35], c: 0x2a2a2a },
			// Small back lip (where the guitar body leans against).
			{ p: [0, 0.22, -0.15], s: [0.42, 0.28, 0.04], c: 0x2a2a2a },
			// Foam pad on the back lip (so the guitar doesn't scratch).
			{ p: [0, 0.22, -0.13], s: [0.38, 0.26, 0.02], c: 0x5a5a5a },
			// Small front bumper (prevents guitar from sliding off).
			{ p: [0, 0.08, 0.15], s: [0.38, 0.04, 0.03], c: 0x2a2a2a },
		];
		setup.add(mergeVoxels(stand));

		// Place the whole setup far to the side so it's separate from sheep and desk.
		setup.position.set(2.6, 0, -1.4);
		return setup;
	}

	function buildFloor(): THREE.Mesh {
		const m = box(10, 0.2, 10, C.floor);
		m.position.set(0, -0.55, 0);
		m.receiveShadow = true;
		return m;
	}

	// ---- Scene boot ---------------------------------------------------------

	function initModels() {
		const wraps = document.querySelectorAll<HTMLElement>(".model-3d");
		const reduced = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		wraps.forEach((wrap) => {
			if (wrap.dataset.inited) return;
			wrap.dataset.inited = "true";

			const canvas =
				wrap.querySelector<HTMLCanvasElement>(".model-canvas");
			const loader = wrap.querySelector<HTMLElement>("[data-loader]");
			if (!canvas) return;

			const scene = new THREE.Scene();

			const aspect = () =>
				(wrap.clientWidth || 320) / (wrap.clientHeight || 320);
			const scale = 3.6;
			const camera = new THREE.OrthographicCamera(
				-scale * aspect(),
				scale * aspect(),
				scale,
				-scale,
				0.01,
				5000,
			);
			const initialPos = new THREE.Vector3(8, 5, 8);
			camera.position.copy(initialPos);
			// Look between sheep (z≈0.4) and monitor (z≈-1.7).
			const target = new THREE.Vector3(0, 0.9, -0.5);
			camera.lookAt(target);

			const renderer = new THREE.WebGLRenderer({
				canvas,
				alpha: true,
				antialias: true,
			});
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.setSize(
				wrap.clientWidth || 320,
				wrap.clientHeight || 320,
				false,
			);
			renderer.shadowMap.enabled = true;
			renderer.shadowMap.type = THREE.PCFSoftShadowMap;

			// Lights.
			scene.add(new THREE.AmbientLight(0xffffff, 0.8));
			const key = new THREE.DirectionalLight(0xffffff, 1.0);
			key.position.set(5, 10, 7);
			key.castShadow = true;
			key.shadow.mapSize.width = 1024;
			key.shadow.mapSize.height = 1024;
			key.shadow.camera.near = 0.5;
			key.shadow.camera.far = 50;
			key.shadow.camera.left = -6;
			key.shadow.camera.right = 6;
			key.shadow.camera.top = 6;
			key.shadow.camera.bottom = -6;
			scene.add(key);

			// World.
			scene.add(buildFloor());
			const sheep = buildSheep();
			scene.add(sheep);
			const desk = buildDesk();
			scene.add(desk);
			const chair = buildChair();
			scene.add(chair);
			const guitar = buildGuitar();
			scene.add(guitar);

			if (loader) loader.classList.add("is-hidden");

			const controls = new OrbitControls(camera, renderer.domElement);
			controls.target.copy(target);
			controls.enableZoom = false;
			controls.enablePan = false;
			controls.enableDamping = true;
			controls.autoRotate = !reduced;
			controls.autoRotateSpeed = 3;
			// Restrict vertical rotation so you can't flip under the floor.
			controls.minPolarAngle = Math.PI * 0.2;
			controls.maxPolarAngle = Math.PI * 0.55;

			let rafId = 0;
			let frame = 0;
			const clock = new THREE.Clock();
			const animate = () => {
				rafId = requestAnimationFrame(animate);

				const t = clock.getElapsedTime();
				// Sheep subtle bob (breathing).
				if (!reduced) {
					sheep.position.y = 0.52 + Math.sin(t * 1.6) * 0.03;
				}

				if (frame <= 100 && !reduced) {
					frame += 1;
					const rot = -easeOutCirc(frame / 100) * Math.PI * 2;
					camera.position.x =
						initialPos.x * Math.cos(rot) +
						initialPos.z * Math.sin(rot);
					camera.position.z =
						initialPos.z * Math.cos(rot) -
						initialPos.x * Math.sin(rot);
					camera.position.y = initialPos.y;
					camera.lookAt(target);
				} else {
					controls.update();
				}
				renderer.render(scene, camera);
			};
			animate();

			const onResize = () => {
				const a = aspect();
				camera.left = -scale * a;
				camera.right = scale * a;
				camera.updateProjectionMatrix();
				renderer.setSize(
					wrap.clientWidth || 320,
					wrap.clientHeight || 320,
					false,
				);
			};
			window.addEventListener("resize", onResize);

			const observer = new MutationObserver(() => {
				if (!document.contains(wrap)) {
					cancelAnimationFrame(rafId);
					window.removeEventListener("resize", onResize);
					controls.dispose();
					renderer.dispose();
					observer.disconnect();
				}
			});
			observer.observe(document.body, { childList: true, subtree: true });
		});
	}

	initModels();
	document.addEventListener("astro:after-swap", initModels);
</script>

