---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{
	toc.length > 0 && (
		<details class="toc-drawer">
			<summary>
				<span class="toc-drawer-icon" aria-hidden="true">≡</span>
				<span class="toc-drawer-label">On this page</span>
				<span class="toc-drawer-count">{toc.length} section{toc.length === 1 ? '' : 's'}</span>
			</summary>
			<nav class="toc-drawer-nav" aria-label="Table of contents (mobile)">
				<ul class="toc-drawer-list">
					{toc.map((h) => (
						<li class:list={['toc-drawer-item', `depth-${h.depth}`]}>
							<a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</details>
	)
}
{
	toc.length > 0 && (
		<aside class="toc-area" aria-label="Table of contents">
			<button
				type="button"
				class="toc-toggle"
				aria-label="Toggle table of contents"
				aria-expanded="true"
			>
				<span class="toc-toggle-icon" aria-hidden="true">›</span>
				<span class="toc-toggle-label">On this page</span>
			</button>
			<nav class="toc">
				<header class="toc-head">
					<p class="toc-label">On this page</p>
					<button
						type="button"
						class="toc-close"
						aria-label="Hide table of contents"
					>
						×
					</button>
				</header>
				<ul class="toc-list">
					{toc.map((h) => (
						<li class:list={['toc-item', `depth-${h.depth}`]}>
							<a href={`#${h.slug}`} data-toc-link={h.slug}>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)
}

<style>
	.toc-area {
		display: none;
	}
	.toc {
		position: sticky;
		top: var(--space-24);
		max-height: calc(100vh - var(--space-24) - var(--space-8));
		overflow-y: auto;
		overscroll-behavior: contain;
		padding-right: var(--space-2);
	}
	.toc-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-3);
	}
	.toc-label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}
	.toc-close {
		display: none;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		padding: 0;
		font-size: var(--text-lg);
		line-height: 1;
		color: var(--color-text-muted);
		background: transparent;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.toc-close:hover {
		color: var(--color-accent);
		border-color: var(--color-border);
		background: var(--color-bg-soft);
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--color-border-soft);
	}
	.toc-item a {
		display: block;
		padding: var(--space-1) var(--space-3);
		margin-left: -1px;
		border-left: 2px solid transparent;
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-muted);
		text-decoration: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.toc-item.depth-3 a {
		padding-left: var(--space-6);
		font-size: var(--text-xs);
	}
	.toc-item a:hover {
		color: var(--color-text-soft);
	}
	.toc-item a.is-active {
		color: var(--color-accent);
		border-left-color: var(--color-accent);
		font-weight: 500;
	}

	/* Toggle button — hidden by default, only shown on wide screens. */
	.toc-toggle {
		display: none;
		position: fixed;
		top: 50%;
		right: var(--space-4);
		transform: translateY(-50%);
		z-index: 150;
		padding: var(--space-2) var(--space-1);
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text-muted);
		cursor: pointer;
		font-family: inherit;
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		writing-mode: vertical-rl;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.toc-toggle:hover {
		color: var(--color-accent);
		background: var(--color-bg-soft);
	}
	.toc-toggle-icon {
		display: none;
	}

	@media (min-width: 1200px) {
		.toc-area {
			display: block;
			position: relative;
		}
		.toc-close {
			display: inline-flex;
		}
	}

	/* Closed state: hide the panel, show the side tab. */
	:global(html[data-toc='closed']) .toc {
		display: none;
	}
	:global(html[data-toc='closed']) .toc-toggle {
		display: block;
	}
	:global(html[data-toc='closed']) .toc-close {
		display: none;
	}

	/* ============================================
	   Mobile drawer — collapsible TOC for narrow screens.
	   Uses native <details> for zero-JS toggle.
	   Hidden on desktop where the floating side panel takes over.
	   ============================================ */
	.toc-drawer {
		display: block;
		margin: 0 0 var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg-soft);
		overflow: hidden;
	}
	.toc-drawer > summary {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		cursor: pointer;
		list-style: none;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-text);
		user-select: none;
		min-height: 44px;
	}
	.toc-drawer > summary::-webkit-details-marker {
		display: none;
	}
	.toc-drawer > summary::marker {
		display: none;
	}
	.toc-drawer-icon {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		line-height: 1;
	}
	.toc-drawer-label {
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.toc-drawer-count {
		margin-left: auto;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		letter-spacing: 0.04em;
	}
	.toc-drawer[open] > summary {
		border-bottom: 1px solid var(--color-border-soft);
	}
	.toc-drawer[open] .toc-drawer-icon {
		color: var(--color-accent);
	}
	.toc-drawer-nav {
		padding: var(--space-2) 0;
		/* Cap the expanded panel's vertical footprint so it doesn't
		   dominate the viewport on mobile. Internal overflow keeps long
		   TOCs scrollable inside this compact box. */
		max-height: 38vh;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	.toc-drawer-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-drawer-item a {
		display: flex;
		align-items: center;
		min-height: 36px;
		padding: var(--space-1) var(--space-4);
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-soft);
		text-decoration: none;
		border-left: 2px solid transparent;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.toc-drawer-item a:hover,
	.toc-drawer-item a:focus-visible {
		color: var(--color-accent);
		background: var(--color-bg);
	}
	.toc-drawer-item a.is-active {
		color: var(--color-accent);
		border-left-color: var(--color-accent);
		font-weight: 500;
		background: var(--color-bg);
	}
	.toc-drawer-item.depth-3 a {
		padding-left: var(--space-8);
		font-size: var(--text-sm);
	}

	/* On mobile the drawer becomes a sticky top bar that stays under the
	   header while the user scrolls. `position: fixed` removes it from
	   the document flow so the article starts immediately under the header
	   instead of leaving a sticky-shaped gap below it. */
	@media (max-width: 1199px) {
		.toc-drawer {
			position: fixed;
			top: 56px;
			left: 0;
			right: 0;
			z-index: 90;
			margin: 0;
			border-radius: 0;
			border-left: 0;
			border-right: 0;
		}
	}

	@media (min-width: 1200px) {
		.toc-drawer {
			display: none;
		}
	}
</style>
