---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingStats, formatReadingTime } from '../utils/reading-time';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const grouped: Record<string, CollectionEntry<'blog'>[]> = {};
for (const post of posts) {
	const year = String(post.data.pubDate.getFullYear());
	(grouped[year] ??= []).push(post);
}
const years = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
---
<section class="posts-by-year">
	{
		years.map((year) => (
			<div class="year-group">
				<span class="year-label" aria-hidden="true">
					{year}
				</span>
				<h2 class="year-heading">{year}</h2>
				<ul class="post-list">
					{grouped[year].map((post) => {
						const stats = readingStats(post.body ?? '');
						return (
							<li class="post-row">
								<a href={`${import.meta.env.BASE_URL}blog/${post.id}/`} class="post-link">
									{post.data.heroImage && (
										<div class="thumb">
											<Image width={160} height={96} src={post.data.heroImage} alt="" />
										</div>
									)}
									<div class="meta">
										<h3 class="title">{post.data.title}</h3>
										<p class="info">
											<FormattedDate date={post.data.pubDate} />
											<span class="dot" aria-hidden="true">·</span>
											<span>{formatReadingTime(stats)}</span>
										</p>
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		))
	}
</section>

<style>
	.posts-by-year {
		position: relative;
		max-width: var(--container-base);
		margin: 0 auto;
		padding: 0 var(--space-4);
	}
	.year-group {
		position: relative;
		padding: var(--space-12) 0 var(--space-8);
	}
	.year-group + .year-group {
		border-top: 1px solid var(--color-border-soft);
	}
	.year-label {
		position: absolute;
		top: -1rem;
		left: -0.1em;
		font-size: clamp(96px, 16vw, 180px);
		font-weight: 800;
		line-height: 1;
		color: var(--color-border-soft);
		letter-spacing: -0.06em;
		pointer-events: none;
		user-select: none;
		z-index: 0;
		opacity: 0.7;
	}
	.year-heading {
		position: relative;
		z-index: 1;
		font-size: var(--text-md);
		color: var(--color-text-muted);
		font-weight: 500;
		margin: 0 0 var(--space-4);
		padding-left: 0.5em;
		letter-spacing: 0.05em;
	}
	.post-list {
		position: relative;
		z-index: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}
	.post-row {
		list-style: none;
	}
	.post-link {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3);
		text-decoration: none;
		border-radius: var(--radius-md);
		transition: background 0.2s ease;
	}
	.post-link:hover {
		background: var(--color-bg-soft);
	}
	.post-link:hover .title {
		color: var(--color-accent);
	}
	.thumb {
		flex-shrink: 0;
		width: 96px;
		height: 64px;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-border-soft);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.meta {
		flex: 1;
		min-width: 0;
	}
	.title {
		margin: 0;
		font-size: var(--text-md);
		color: var(--color-text);
		font-weight: 500;
		line-height: var(--leading-snug);
		transition: color 0.2s ease;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.info {
		margin: var(--space-1) 0 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.info .dot {
		opacity: 0.5;
	}
	@media (max-width: 600px) {
		.thumb {
			width: 64px;
			height: 48px;
		}
		.title {
			white-space: normal;
			font-size: var(--text-base);
		}
		.year-label {
			font-size: 80px;
		}
	}
</style>
