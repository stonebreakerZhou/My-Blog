---
/**
 * Interactive 3D avatar card.
 * - Auto-rotates slowly.
 * - Drag horizontally (mouse / touch) to spin.
 * - Releases with momentum, then decays back to base speed.
 * - Keyboard: ← / → nudge 15°.
 * - Respects prefers-reduced-motion.
 */
interface Props {
	size?: number;
	class?: string;
}
const { size = 200, class: className = "" } = Astro.props;
const imageUrl = `${import.meta.env.BASE_URL}site-assets/profile_portrait.webp`;
---

<div
	class:list={["avatar-3d", className]}
	style={`--size: ${size}px;`}
	role="img"
	aria-label="Stonebreaker's avatar — drag to rotate"
	tabindex="0"
>
	<div class="cube">
		<div class="face face-front">
			<img src={imageUrl} alt="" draggable="false" />
		</div>
		<div class="face face-back">
			<div class="back-content">
				<p class="quote">
					"Build AI intuition<br />from first principles."
				</p>
				<span class="signature">— Stonebreaker</span>
			</div>
		</div>
	</div>
</div>

<script>
	function initAvatar() {
		const containers = document.querySelectorAll<HTMLElement>(".avatar-3d");
		const reduced = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		containers.forEach((container) => {
			const cube = container.querySelector<HTMLElement>(".cube");
			if (!cube) return;

			// Reduced motion → static, slight angle to show it's two-sided
			if (reduced) {
				cube.style.transform = "rotateY(-18deg)";
				container.style.cursor = "default";
				container.removeAttribute("tabindex");
				return;
			}

			let rotation = 0;
			let velocity = 0.25;
			const baseVelocity = 0.25;
			const dampening = 0.94;
			const dragSensitivity = 0.5;
			let dragging = false;
			let lastX = 0;
			let lastMoveAt = 0;
			let rafId = 0;

			const tick = () => {
				if (!dragging) {
					velocity =
						velocity * dampening + baseVelocity * (1 - dampening);
					rotation += velocity;
				}
				cube.style.transform = `rotateY(${rotation}deg)`;
				rafId = requestAnimationFrame(tick);
			};

			const onDown = (e: PointerEvent) => {
				dragging = true;
				lastX = e.clientX;
				lastMoveAt = e.timeStamp;
				velocity = 0;
				container.setPointerCapture(e.pointerId);
			};
			const onMove = (e: PointerEvent) => {
				if (!dragging) return;
				const dx = e.clientX - lastX;
				const dt = Math.max(1, e.timeStamp - lastMoveAt);
				rotation += dx * dragSensitivity;
				velocity = dx * dragSensitivity * (16 / dt);
				lastX = e.clientX;
				lastMoveAt = e.timeStamp;
			};
			const onUp = (e: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				container.releasePointerCapture(e.pointerId);
			};

			container.addEventListener("pointerdown", onDown);
			container.addEventListener("pointermove", onMove);
			container.addEventListener("pointerup", onUp);
			container.addEventListener("pointercancel", onUp);

			container.addEventListener("keydown", (e) => {
				if (e.key === "ArrowLeft") {
					rotation -= 15;
					velocity = -3;
				} else if (e.key === "ArrowRight") {
					rotation += 15;
					velocity = 3;
				}
			});

			rafId = requestAnimationFrame(tick);

			// Cleanup if the element gets removed (View Transitions re-runs init)
			const observer = new MutationObserver(() => {
				if (!document.contains(container)) {
					cancelAnimationFrame(rafId);
					observer.disconnect();
				}
			});
			observer.observe(document.body, { childList: true, subtree: true });
		});
	}

	initAvatar();
	document.addEventListener("astro:after-swap", initAvatar);
</script>

<style>
	.avatar-3d {
		width: var(--size, 200px);
		height: var(--size, 200px);
		margin: 0 auto;
		perspective: 1200px;
		cursor: grab;
		user-select: none;
		touch-action: none;
	}
	.avatar-3d:active {
		cursor: grabbing;
	}
	.avatar-3d:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 8px;
		border-radius: 50%;
	}

	.cube {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.face {
		position: absolute;
		inset: 0;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		border-radius: 50%;
		overflow: hidden;
		border: 4px solid var(--color-bg);
		box-shadow:
			var(--shadow-lg),
			0 0 0 1px var(--color-border-soft);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-6);
	}

	.face-front {
		transform: translateZ(1px);
		padding: 0;
	}
	.face-front img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
	}

	.face-back {
		transform: rotateY(180deg) translateZ(1px);
		background:
			radial-gradient(
				circle at 30% 30%,
				var(--color-accent-soft),
				transparent 60%
			),
			var(--color-bg-soft);
		text-align: center;
	}

	.back-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		align-items: center;
	}

	.quote {
		margin: 0;
		font-family: var(--font-prose);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-text);
	}

	.signature {
		font-family: var(--font-script);
		font-size: 1.4rem;
		color: var(--color-accent-text);
		line-height: 1;
	}
</style>
