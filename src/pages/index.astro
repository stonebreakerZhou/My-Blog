---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Signature from "../components/Signature.astro";
import Avatar3D from "../components/Avatar3D.astro";

const recentPosts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title="Stonebreaker"
	description="AI learning notes · AI undergraduate @ BIT"
>
	<section class="hero">
		<div
			class="hero-banner"
			role="img"
			aria-label="Starry night sky with STONEBREAKER constellation"
			style={`background-image: url('${import.meta.env.BASE_URL}homepage_background.png')`}
		>
		</div>

		<div class="hero-content">
			<Avatar3D size={200} class="avatar-3d-wrap" />
			<Signature variant="home" />
			<p class="tagline">AI undergraduate @ BIT</p>
			<p class="bio">
				Thoughts on AI, DL, ML and learning notes<br />
			</p>
			<div class="hero-social">
				<SocialLinks size={18} />
			</div>
		</div>
	</section>

	<section class="recent">
		<div class="section-header">
			<h2>Recent posts</h2>
			<a href={`${import.meta.env.BASE_URL}blog/`} class="see-all"
				>See all →</a
			>
		</div>
		<PostList posts={recentPosts} />
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		margin-top: calc(-1 * var(--space-12));
	}
	.hero-banner {
		width: 100%;
		aspect-ratio: 1696 / 624;
		max-height: clamp(280px, 42vw, 480px);
		background-size: contain;
		background-position: center;
		background-repeat: no-repeat;
	}
	.hero-content {
		position: relative;
		max-width: var(--container-narrow);
		margin: -56px auto 0;
		padding: 0 var(--space-4) var(--space-8);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-2);
	}
	.avatar-3d-wrap {
		margin-bottom: var(--space-4);
	}
	.tagline {
		margin: var(--space-2) 0 0;
		color: var(--color-text);
		font-family: var(--font-prose);
		font-size: var(--text-lg);
		font-weight: 500;
	}
	.bio {
		margin: 0;
		color: var(--color-text-soft);
		font-family: var(--font-prose);
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
	}
	.hero-social {
		margin-top: var(--space-2);
	}

	.recent {
		padding: var(--space-8) 0 var(--space-8);
	}
	.section-header {
		max-width: var(--container-wide);
		margin: 0 auto var(--space-6);
		padding: 0 var(--space-4);
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.section-header h2 {
		font-size: var(--text-2xl);
		margin: 0;
	}
	.see-all {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.see-all:hover {
		color: var(--color-accent);
	}
</style>
