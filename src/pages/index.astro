---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---
<BaseLayout
	title="Sean · StoneBreaker"
	description="AI research & learning notes"
>
	<section class="hero">
		<div class="hero-banner" role="img" aria-label="Starry night sky with STONEBREAKER constellation"></div>

		<div class="hero-content">
			<img class="avatar" src={`${import.meta.env.BASE_URL}head_portrait.jpg`} alt="Stonebreaker's portrait" />
			<p class="script-name-small">Stonebreaker</p>
			<p class="tagline">AI development student @ BIT</p>
			<p class="bio">
				记录我对 AI、深度学习、机器学习的思考与笔记。<br />
				欢迎找我交流。
			</p>
			<div class="hero-social">
				<SocialLinks size={18} />
			</div>
		</div>
	</section>

	<section class="recent">
		<div class="section-header">
			<h2>Recent posts</h2>
			<a href={`${import.meta.env.BASE_URL}blog/`} class="see-all">See all →</a>
		</div>
		<PostList posts={recentPosts} />
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		margin-top: calc(-1 * var(--space-12));
	}
	.hero-banner {
		width: 100%;
		aspect-ratio: 1696 / 624;
		max-height: clamp(280px, 42vw, 480px);
		background-image: url('/homepage_background.png');
		background-size: contain;
		background-position: center;
		background-repeat: no-repeat;
	}
	.hero-content {
		position: relative;
		max-width: var(--container-narrow);
		margin: -56px auto 0;
		padding: 0 var(--space-4) var(--space-8);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-2);
	}
	.avatar {
		width: 112px;
		height: 112px;
		border-radius: 50%;
		border: 4px solid var(--color-bg);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
		object-fit: cover;
		display: block;
		margin-bottom: var(--space-3);
	}
	.script-name-small {
		font-family: var(--font-script);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 400;
		line-height: 1;
		margin: 0;
		color: var(--color-text);
		letter-spacing: 0.01em;
	}
	.tagline {
		margin: var(--space-2) 0 0;
		color: var(--color-text);
		font-size: var(--text-lg);
		font-weight: 500;
	}
	.bio {
		margin: 0;
		color: var(--color-text-soft);
		font-size: var(--text-base);
		line-height: var(--leading-relaxed, 1.7);
	}
	.hero-social {
		margin-top: var(--space-2);
	}

	.recent {
		padding: var(--space-8) 0 var(--space-8);
	}
	.section-header {
		max-width: var(--container-wide);
		margin: 0 auto var(--space-6);
		padding: 0 var(--space-4);
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.section-header h2 {
		font-size: var(--text-2xl);
		margin: 0;
	}
	.see-all {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.see-all:hover {
		color: var(--color-accent);
	}
</style>
