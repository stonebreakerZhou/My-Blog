---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingStats } from '../../utils/reading-time';

export async function getStaticPaths() {
	const sorted = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return sorted.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			stats: readingStats(post.body ?? ''),
			newer: sorted[i - 1] ?? null,
			older: sorted[i + 1] ?? null,
		},
	}));
}

type Props = {
	post: CollectionEntry<'blog'>;
	stats: ReturnType<typeof readingStats>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
};

const { post, stats, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---
<BlogPost
	{...post.data}
	readingStats={stats}
	newer={newer}
	older={older}
	headings={headings}
>
	<Content />
</BlogPost>
