---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Signature from "../components/Signature.astro";
import Model3D from "../components/Model3D.astro";

const now = {
	based: "Beijing, China",
	role: "AI undergraduate @ BIT",
	focus: "Building AI intuition from first principles",
};

const techStack = [
	{
		name: "PyTorch",
		href: "https://www.bilibili.com/video/BV1Y7411d7Ys/?spm_id_from=333.1387.favlist.content.click",
	},
	{ name: "DL", href: "https://d2l.ai/" },
	{ name: "ML", href: "https://cs229.stanford.edu/" },
	{ name: "Typst", href: "https://typst.app/docs" },
];

const learning = [
	{
		name: "CS336",
		href: "https://github.com/stonebreakerZhou/Stanford_CS336_26spring",
	},
	{
		name: "RL",
		href: "https://github.com/stonebreakerZhou/RL_note_WestLakeU",
	},
	{ name: "LM alignment" },
	{ name: "DL math" },
];

const offDesk = ["Basketball", "History", "Bad math jokes"];

const findLabels = ["GitHub", "Zhihu", "Email"];
---

<BaseLayout
	title="About · Stonebreaker"
	description="Stonebreaker — AI undergraduate at BIT."
>
	<article class="about">
		<Model3D size={340} class="about-model" />
		<header class="hero">
			<img
				class="avatar"
				src={`${import.meta.env.BASE_URL}head_portrait.jpg`}
				alt="Stonebreaker's portrait"
			/>
			<Signature variant="about" />
			<p class="tagline">
				AI undergraduate. Trying to understand AI deeply.
			</p>
		</header>

		<section class="facts">
			<div class="fact">
				<span class="label">Based in</span>
				<span class="value">{now.based}</span>
			</div>
			<div class="fact">
				<span class="label">Role</span>
				<span class="value">{now.role}</span>
			</div>
			<div class="fact">
				<span class="label">Focus</span>
				<span class="value">{now.focus}</span>
			</div>
		</section>

		<section class="prose-section">
			<h2>About me</h2>
			<p>
				I'm stonebreakerZhou, an undergraduate at BIT, Beijing. Most of
				what I do is studying DL and trying to understand <em>why</em> things
				work the way they do — not just call the API and ship.
			</p>
			<p>
				I started this blog to write notes on what I'm learning: ML, DL,
				RL, AI safety and math behind them. If you're reading this, hi —
				pull up a chair.
			</p>
		</section>

		<section class="chips-section">
			<h2>Tech stack</h2>
			<ul class="chips">
				{
					techStack.map((t) => (
						<li class="chip">
							{t.href ? (
								<a
									href={t.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{t.name}
								</a>
							) : (
								t.name
							)}
						</li>
					))
				}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Currently learning</h2>
			<ul class="chips">
				{
					learning.map((item) => (
						<li class="chip">
							{item.href ? (
								<a
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{item.name}
								</a>
							) : (
								item.name
							)}
						</li>
					))
				}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Off the desk</h2>
			<ul class="chips soft">
				{offDesk.map((t) => <li class="chip">{t}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Find me</h2>
			<div class="find-me">
				<SocialLinks size={20} />
				<p class="find-me-labels">
					{findLabels.map((name) => <span>{name}</span>)}
				</p>
			</div>
		</section>
	</article>
</BaseLayout>

<style>
	.about {
		max-width: var(--container-narrow);
		margin: 0 auto;
		padding: 0 var(--space-4);
		font-family: var(--font-prose);
	}

	.hero {
		text-align: center;
		padding: var(--space-12) 0 var(--space-12);
	}
	.about-model {
		margin-top: var(--space-8);
	}
	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		border: 3px solid var(--color-bg);
		box-shadow: var(--shadow-md);
		object-fit: cover;
		display: block;
		margin: 0 auto var(--space-5);
	}
	.tagline {
		margin: var(--space-6) auto 0;
		max-width: 460px;
		color: var(--color-text-soft);
		font-size: var(--text-md);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		padding: var(--space-8) 0;
		border-top: 1px solid var(--color-border-soft);
		border-bottom: 1px solid var(--color-border-soft);
		margin-bottom: var(--space-8);
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}
	.label {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.value {
		font-size: var(--text-sm);
		color: var(--color-text);
		font-weight: 500;
		line-height: var(--leading-snug);
	}
	@media (max-width: 600px) {
		.facts {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}

	.prose-section,
	.chips-section {
		margin-bottom: var(--space-10);
		padding-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-border-soft);
	}
	.prose-section:last-of-type,
	.chips-section:last-of-type {
		border-bottom: 0;
		margin-bottom: 0;
	}
	.prose-section h2,
	.chips-section h2 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-5);
		font-weight: 600;
	}
	.prose-section p {
		color: var(--color-text-soft);
		margin-bottom: var(--space-3);
		line-height: var(--leading-relaxed);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.chip {
		padding: var(--space-1) var(--space-3);
		background: var(--color-accent-soft);
		color: var(--color-accent-text);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}
	.chips.soft .chip {
		background: var(--color-bg-soft);
		color: var(--color-text-soft);
	}
	.chip a {
		color: inherit;
		text-decoration: none;
	}
	.chip a:hover {
		color: var(--color-accent);
	}

	.find-me {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
	}
	.find-me-labels {
		margin: 0;
		display: flex;
		gap: var(--space-8);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		letter-spacing: 0.02em;
	}
</style>
