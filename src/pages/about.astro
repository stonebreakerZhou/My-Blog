---
import BaseLayout from '../layouts/BaseLayout.astro';

const now = {
	based: 'Beijing, China',
	role: 'CS freshman @ Beijing Institute of Technology',
	focus: 'Building AI intuition from first principles',
};

const techStack = [
	'Python', 'PyTorch', 'Git', 'Linux',
	'Deep Learning', 'Machine Learning',
	'C/C++', 'Markdown',
];

const learning = [
	'Transformer architecture internals',
	'Math behind deep learning',
	'How modern PyTorch actually works',
];

const offDesk = ['Basketball', 'History', 'Bad math jokes'];

const links = [
	{ name: 'GitHub', href: 'https://github.com/HelloMyWorld419', external: true },
	{ name: 'Zhihu', href: 'https://www.zhihu.com/people/laughable-young', external: true },
	{ name: 'RSS', href: '/rss.xml', external: false },
];
---
<BaseLayout title="About" description="Sean / Stonebreaker — CS freshman at Beijing Institute of Technology.">
	<article class="about">

		<header class="hero">
			<div class="avatar" aria-hidden="true">S</div>
			<h1>Sean</h1>
			<p class="alias">Stonebreaker</p>
			<p class="tagline">CS freshman. Trying to understand AI deeply, not just use the APIs.</p>
		</header>

		<section class="facts">
			<div class="fact">
				<span class="label">Based in</span>
				<span class="value">{now.based}</span>
			</div>
			<div class="fact">
				<span class="label">Role</span>
				<span class="value">{now.role}</span>
			</div>
			<div class="fact">
				<span class="label">Focus</span>
				<span class="value">{now.focus}</span>
			</div>
		</section>

		<section class="prose-section">
			<h2>About me</h2>
			<p>
				I'm Sean, a freshman at Beijing Institute of Technology. Most of what I do is study
				machine learning and try to understand <em>why</em> things work the way they do —
				not just call the API and ship.
			</p>
			<p>
				I started this blog to write notes on what I'm learning: transformer architectures,
				attention mechanisms, and the math behind them. If you're reading this, hi — pull up
				a chair.
			</p>
		</section>

		<section class="chips-section">
			<h2>Tech stack</h2>
			<ul class="chips">
				{techStack.map((t) => <li class="chip">{t}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Currently learning</h2>
			<ul class="list">
				{learning.map((l) => <li>{l}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Off the desk</h2>
			<ul class="chips soft">
				{offDesk.map((t) => <li class="chip">{t}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Find me</h2>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
							>
								{link.name}
							</a>
						</li>
					))
				}
			</ul>
		</section>

	</article>
</BaseLayout>

<style>
	.about {
		max-width: var(--container-narrow);
		margin: 0 auto;
		padding: 0 var(--space-4);
	}

	.hero {
		text-align: center;
		padding: var(--space-12) 0 var(--space-8);
	}
	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--color-accent), var(--color-accent-text));
		color: white;
		font-size: var(--text-4xl);
		font-weight: 700;
		line-height: 96px;
		margin: 0 auto var(--space-4);
		letter-spacing: -0.03em;
		box-shadow: var(--shadow-md);
	}
	.hero h1 {
		margin: 0;
		font-size: var(--text-4xl);
		letter-spacing: -0.03em;
	}
	.alias {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-md);
		font-weight: 500;
	}
	.tagline {
		margin: var(--space-6) auto 0;
		max-width: 460px;
		color: var(--color-text-soft);
		font-size: var(--text-md);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		padding: var(--space-8) 0;
		border-top: 1px solid var(--color-border-soft);
		border-bottom: 1px solid var(--color-border-soft);
		margin-bottom: var(--space-8);
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}
	.label {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.value {
		font-size: var(--text-sm);
		color: var(--color-text);
		font-weight: 500;
		line-height: var(--leading-snug);
	}
	@media (max-width: 600px) {
		.facts {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}

	.prose-section,
	.chips-section {
		margin-bottom: var(--space-10);
	}
	.prose-section h2,
	.chips-section h2 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-4);
		font-weight: 600;
	}
	.prose-section p {
		color: var(--color-text-soft);
		margin-bottom: var(--space-3);
		line-height: var(--leading-relaxed);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.chip {
		padding: var(--space-1) var(--space-3);
		background: var(--color-accent-soft);
		color: var(--color-accent-text);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}
	.chips.soft .chip {
		background: var(--color-bg-soft);
		color: var(--color-text-soft);
	}

	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list li {
		color: var(--color-text-soft);
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--color-border-soft);
		font-size: var(--text-md);
	}
	.list li:last-child {
		border-bottom: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
	}
	.links a {
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-md);
		font-weight: 500;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2px;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.links a:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
</style>
