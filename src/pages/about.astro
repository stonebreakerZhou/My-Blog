---
import BaseLayout from "../layouts/BaseLayout.astro";

const now = {
	based: "Beijing, China",
	role: "CS freshman @ BIT",
	focus: "Building AI intuition from first principles",
};

const techStack = ["PyTorch", "DL", "ML", "Typst"];

const learning = [
	{ name: "CS336", href: "https://github.com/stonebreakerZhou/Stanford_CS336_26spring" },
	{ name: "RL", href: "https://github.com/stonebreakerZhou/RL_note_WestLakeU" },
	{ name: "LM alignment" },
	{ name: "DL math" },
];

const offDesk = ["Basketball", "History", "Bad math jokes"];

const links = [
	{
		name: "GitHub",
		href: "https://github.com/stonebreakerZhou",
		external: true,
	},
	{
		name: "Zhihu",
		href: "https://www.zhihu.com/people/laughyoung",
		external: true,
	},
	{
		name: "Email",
		href: "mailto:stonebreaker365@163.com",
		external: true,
	},
];
---

<BaseLayout title="About" description="Stonebreaker — CS freshman at BIT.">
	<article class="about">
		<header class="hero">
			<img class="avatar" src={`${import.meta.env.BASE_URL}head_portrait.jpg`} alt="Stonebreaker's portrait" />
			<p class="alias">Stonebreaker</p>
			<p class="tagline">CS freshman. Trying to understand AI deeply.</p>
		</header>

		<section class="facts">
			<div class="fact">
				<span class="label">Based in</span>
				<span class="value">{now.based}</span>
			</div>
			<div class="fact">
				<span class="label">Role</span>
				<span class="value">{now.role}</span>
			</div>
			<div class="fact">
				<span class="label">Focus</span>
				<span class="value">{now.focus}</span>
			</div>
		</section>

		<section class="prose-section">
			<h2>About me</h2>
			<p>
				I'm StoneBreaker, a freshman at BIT, Beijing. Most of what I do
				is study DL and try to understand <em>why</em> things work the way
				they do — not just call the API and ship.
			</p>
			<p>
				I started this blog to write notes on what I'm learning: ML, DL,
				RL, AI safety and math behind them. If you're reading this, hi —
				pull up a chair.
			</p>
		</section>

		<section class="chips-section">
			<h2>Tech stack</h2>
			<ul class="chips">
				{techStack.map((t) => <li class="chip">{t}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Currently learning</h2>
			<ul class="chips">
				{learning.map((item) => (
					<li class="chip">
						{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a> : item.name}
					</li>
				))}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Off the desk</h2>
			<ul class="chips soft">
				{offDesk.map((t) => <li class="chip">{t}</li>)}
			</ul>
		</section>

		<section class="chips-section">
			<h2>Find me</h2>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.external ? "_blank" : undefined}
								rel={
									link.external
										? "noopener noreferrer"
										: undefined
								}
							>
								{link.name}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</article>
</BaseLayout>

<style>
	.about {
		max-width: var(--container-narrow);
		margin: 0 auto;
		padding: 0 var(--space-4);
	}

	.hero {
		text-align: center;
		padding: var(--space-12) 0 var(--space-12);
	}
	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		border: 3px solid var(--color-bg);
		box-shadow: var(--shadow-md);
		object-fit: cover;
		display: block;
		margin: 0 auto var(--space-5);
	}
	.alias {
		margin: 0;
		color: var(--color-text);
		font-size: var(--text-2xl);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.tagline {
		margin: var(--space-6) auto 0;
		max-width: 460px;
		color: var(--color-text-soft);
		font-size: var(--text-md);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		padding: var(--space-8) 0;
		border-top: 1px solid var(--color-border-soft);
		border-bottom: 1px solid var(--color-border-soft);
		margin-bottom: var(--space-8);
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}
	.label {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.value {
		font-size: var(--text-sm);
		color: var(--color-text);
		font-weight: 500;
		line-height: var(--leading-snug);
	}
	@media (max-width: 600px) {
		.facts {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}

	.prose-section,
	.chips-section {
		margin-bottom: var(--space-10);
		padding-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-border-soft);
	}
	.prose-section:last-of-type,
	.chips-section:last-of-type {
		border-bottom: 0;
		margin-bottom: 0;
	}
	.prose-section h2,
	.chips-section h2 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-5);
		font-weight: 600;
	}
	.prose-section p {
		color: var(--color-text-soft);
		margin-bottom: var(--space-3);
		line-height: var(--leading-relaxed);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.chip {
		padding: var(--space-1) var(--space-3);
		background: var(--color-accent-soft);
		color: var(--color-accent-text);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}
	.chips.soft .chip {
		background: var(--color-bg-soft);
		color: var(--color-text-soft);
	}
	.chip a {
		color: inherit;
		text-decoration: none;
	}
	.chip a:hover {
		color: var(--color-accent);
	}

	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list li {
		color: var(--color-text-soft);
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--color-border-soft);
		font-size: var(--text-md);
	}
	.list li:last-child {
		border-bottom: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
	}
	.links a {
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-md);
		font-weight: 500;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2px;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.links a:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
</style>
