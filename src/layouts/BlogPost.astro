---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import {
	readingStats,
	formatReadingTime,
	formatWordCount,
} from '../utils/reading-time';

type Props = CollectionEntry<'blog'>['data'] & {
	readingStats: ReturnType<typeof readingStats>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
};
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	readingStats,
	newer,
	older,
} = Astro.props;

function postHref(post: CollectionEntry<'blog'>): string {
	return `${import.meta.env.BASE_URL}blog/${post.id}/`;
}
---
<BaseLayout title={title} description={description}>
	<article class="article">
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="prose">
			<header class="post-header">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<hr />
				<p class="meta">
					<span>{formatReadingTime(readingStats)}</span>
					<span class="dot" aria-hidden="true">·</span>
					<span>{formatWordCount(readingStats)}</span>
				</p>
			</header>
			<slot />
			{
				(newer || older) && (
					<nav class="post-nav" aria-label="Post navigation">
						{older ? (
							<a class="post-nav-link prev" href={postHref(older)}>
								<span class="dir">← Older post</span>
								<span class="nav-title">{older.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{newer ? (
							<a class="post-nav-link next" href={postHref(newer)}>
								<span class="dir">Newer post →</span>
								<span class="nav-title">{newer.data.title}</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		width: 100%;
	}
	.hero-image {
		max-width: var(--container-wide);
		margin: 0 auto var(--space-8);
	}
	.hero-image :global(img) {
		width: 100%;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-lg);
	}
	.prose {
		width: var(--container-base);
		max-width: calc(100% - var(--space-8));
		margin: 0 auto;
		color: var(--color-text);
	}
	.post-header {
		text-align: center;
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-6);
	}
	.post-header h1 {
		margin: var(--space-4) 0;
		font-size: var(--text-4xl);
	}
	.date {
		margin-bottom: var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.last-updated-on {
		font-style: italic;
		margin-top: var(--space-1);
	}
	.meta {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.meta .dot {
		opacity: 0.5;
	}

	.post-nav {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-soft);
	}
	.post-nav-link {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4) var(--space-5);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.post-nav-link:hover {
		background: var(--color-bg-soft);
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	.post-nav-link.next {
		text-align: right;
		align-items: flex-end;
	}
	.dir {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post-nav-link:hover .dir {
		color: var(--color-text-soft);
	}
	.nav-title {
		font-weight: 500;
		line-height: var(--leading-snug);
	}
	@media (max-width: 600px) {
		.post-nav {
			flex-direction: column;
		}
	}
</style>
