---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
	formatReadingTime,
	formatWordCount,
	type ReadingStats,
} from '../utils/reading-time';

type Props = CollectionEntry<'blog'>['data'] & {
	readingStats: ReadingStats;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
	headings: MarkdownHeading[];
};
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	readingStats,
	newer,
	older,
	headings,
} = Astro.props;

function postHref(post: CollectionEntry<'blog'>): string {
	return `${import.meta.env.BASE_URL}blog/${post.id}/`;
}
---
<BaseLayout title={`${title} · Stonebreaker`} description={description}>
	<div class="reading-progress" aria-hidden="true"></div>
	<article class="article">
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="post-shell">
			<div class="prose">
				<header class="post-header">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
					<p class="meta">
						<span>{formatReadingTime(readingStats)}</span>
						<span class="dot" aria-hidden="true">·</span>
						<span>{formatWordCount(readingStats)}</span>
					</p>
				</header>
				<slot />
				{
					(newer || older) && (
						<nav class="post-nav" aria-label="Post navigation">
							{older ? (
								<a class="post-nav-link prev" href={postHref(older)}>
									<span class="dir">← Older post</span>
									<span class="nav-title">{older.data.title}</span>
								</a>
							) : (
								<span />
							)}
							{newer ? (
								<a class="post-nav-link next" href={postHref(newer)}>
									<span class="dir">Newer post →</span>
									<span class="nav-title">{newer.data.title}</span>
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</div>
			<TableOfContents headings={headings} />
		</div>
	</article>
</BaseLayout>

<script>
	import { initCodeCopy } from '../scripts/code-copy.js';
	import { initTocActive } from '../scripts/toc-active.js';
	import { initReadingProgress } from '../scripts/reading-progress.js';
	import { initHeadingAnchors } from '../scripts/heading-anchors.js';
	import { initTocToggle } from '../scripts/toc-toggle.js';

	document.addEventListener('astro:page-load', () => {
		initCodeCopy();
		initTocActive();
		initReadingProgress();
		initHeadingAnchors();
		initTocToggle();
	});
</script>

<style>
	.article {
		width: 100%;
	}
	.hero-image {
		max-width: var(--container-wide);
		margin: 0 auto var(--space-8);
	}
	.hero-image :global(img) {
		width: 100%;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-lg);
	}
	.prose {
		width: var(--container-base);
		max-width: calc(100% - var(--space-8));
		margin: 0 auto;
		color: var(--color-text);
	}
	.prose :global(:is(h1, h2, h3, h4)) {
		scroll-margin-top: var(--space-24);
	}
	.post-shell {
		display: block;
	}
	.post-header {
		text-align: center;
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-6);
	}
	.post-header h1 {
		margin: var(--space-4) 0;
		font-size: var(--text-4xl);
	}
	.date {
		margin-bottom: var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.last-updated-on {
		font-style: italic;
		margin-top: var(--space-1);
	}
	.meta {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.meta .dot {
		opacity: 0.5;
	}

	.post-nav {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-soft);
	}
	.post-nav-link {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4) var(--space-5);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.post-nav-link:hover {
		background: var(--color-bg-soft);
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	.post-nav-link.next {
		text-align: right;
		align-items: flex-end;
	}
	.dir {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post-nav-link:hover .dir {
		color: var(--color-text-soft);
	}
	.nav-title {
		font-weight: 500;
		line-height: var(--leading-snug);
	}
	@media (max-width: 720px) {
		.hero-image {
			margin: 0 0 var(--space-6);
		}
		.hero-image :global(img) {
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-sm);
		}
		.post-nav {
			flex-direction: column;
		}
	}

	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		transform: scaleX(0);
		transform-origin: left;
		background: var(--color-accent);
		z-index: 200;
		will-change: transform;
		pointer-events: none;
	}

	.prose :global(.code-block) {
		position: relative;
	}
	.prose :global(.code-copy) {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		padding: var(--space-1) var(--space-2);
		font-size: var(--text-xs);
		font-family: inherit;
		line-height: 1;
		color: var(--color-text-soft);
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		cursor: pointer;
		opacity: 0;
		transition:
			opacity 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.prose :global(.code-block:hover .code-copy),
	.prose :global(.code-copy:focus-visible) {
		opacity: 1;
	}
	.prose :global(.code-copy:hover) {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	.prose :global(.code-copy.is-copied) {
		opacity: 1;
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.prose :global(.heading-anchor) {
		display: inline-block;
		margin-left: var(--space-2);
		color: var(--color-text-muted);
		font-weight: 400;
		text-decoration: none;
		opacity: 0;
		transition:
			opacity 0.15s ease,
			color 0.15s ease;
	}
	.prose :global(h2:hover) .heading-anchor,
	.prose :global(h3:hover) .heading-anchor,
	.prose :global(h4:hover) .heading-anchor,
	.prose :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}
	.prose :global(.heading-anchor:hover),
	.prose :global(.heading-anchor.is-copied) {
		color: var(--color-accent);
		opacity: 1;
	}

	@media (min-width: 1200px) {
		:global(main#main-content:has(.post-shell)) {
			max-width: var(--container-base);
		}
		.post-shell {
			display: block;
		}
		.prose {
			width: 100%;
			max-width: none;
			margin: 0;
		}
		/* TOC floats over the right edge — never affects the article's centering. */
		.post-shell > :global(.toc-area) {
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			width: 260px;
			padding: var(--space-24) var(--space-6) var(--space-8);
		}
		/* The TOC panel slides out, but the toggle tab stays clickable. */
		.post-shell > :global(.toc-area) :global(.toc) {
			transition: opacity 0.2s ease, transform 0.25s ease;
		}
		:global(html[data-toc='closed']) .post-shell > :global(.toc-area) :global(.toc) {
			opacity: 0;
			transform: translateX(20px);
			pointer-events: none;
		}
	}
</style>
